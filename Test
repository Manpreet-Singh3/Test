
from pymongo import MongoClient, ASCENDING
import time

client = MongoClient(
    "mongodb://localhost:27017/",
    serverSelectionTimeoutMS=30000,
    socketTimeoutMS=None
)

db = client["YOUR_DATABASE"]
col = db["SITcalculations_test"]

BATCH_SIZE = 500
INDEX_NAME = "idx_sitCalcs_BA_temp"

total_modified = 0
batch_number = 0

start_time = time.time()

try:
    # 1. Create temporary index
    print("Creating temporary index...")

    col.create_index(
        [("payload.sitCalcs.BA", ASCENDING)],
        name=INDEX_NAME
    )

    print("Index created successfully.")

    # 2. Aggregation update pipeline
    pipeline = [
        {
            "$set": {
                "payload.sitCalcs": {
                    "$let": {
                        "vars": {
                            "movedMeasurements": {
                                "$reduce": {
                                    "input": {
                                        "$filter": {
                                            "input": "$payload.sitCalcs",
                                            "as": "c",
                                            "cond": {
                                                "$in": [
                                                    "$$c.BA",
                                                    ["CPLE", "CPLW"]
                                                ]
                                            }
                                        }
                                    },
                                    "initialValue": [],
                                    "in": {
                                        "$concatArrays": [
                                            "$$value",
                                            {
                                                "$ifNull": [
                                                    "$$this.Measurements", []
                                                ]
                                            }
                                        ]
                                    }
                                }
                            },
                            "remainingCalcs": {
                                "$filter": {
                                    "input": "$payload.sitCalcs",
                                    "as": "c",
                                    "cond": {
                                        "$not": [
                                            {
                                                "$in": [
                                                    "$$c.BA",
                                                    ["CPLE", "CPLW"]
                                                ]
                                            }
                                        ]
                                    }
                                }
                            }
                        },
                        "in": {
                            "$map": {
                                "input": "$$remainingCalcs",
                                "as": "item",
                                "in": {
                                    "$cond": [
                                        {
                                            "$and": [
                                                {"$eq": ["$$item.BA", "DUK"]},
                                                {"$eq": ["$$item.RC", "VACAR"]}
                                            ]
                                        },
                                        {
                                            "$mergeObjects": [
                                                "$$item",
                                                {
                                                    "Measurements": {
                                                        "$concatArrays": [
                                                            {
                                                                "$ifNull": [
                                                                    "$$item.Measurements",
                                                                    []
                                                                ]
                                                            },
                                                            "$$movedMeasurements"
                                                        ]
                                                    }
                                                }
                                            ]
                                        },
                                        "$$item"
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        }
    ]

    # 3. Process in batches
    while True:

        batch_ids = [
            doc["_id"]
            for doc in col.find(
                {
                    "payload.sitCalcs.BA": {
                        "$in": ["CPLE", "CPLW"]
                    }
                },
                {"_id": 1}
            ).limit(BATCH_SIZE)
        ]

        if not batch_ids:
            break

        batch_number += 1

        result = col.update_many(
            {"_id": {"$in": batch_ids}},
            pipeline
        )

        total_modified += result.modified_count

        print(
            f"Batch: {batch_number} | "
            f"Modified: {result.modified_count} | "
            f"Total: {total_modified} | "
            f"Time: {round(time.time() - start_time, 2)} sec"
        )

    print("\nProcessing completed successfully!")

except Exception as e:
    print("ERROR:", str(e))

finally:

    # 4. Drop temporary index
    try:
        if INDEX_NAME in col.index_information():
            col.drop_index(INDEX_NAME)
            print("Temporary index dropped successfully.")

    except Exception as index_error:
        print("Index cleanup failed:", str(index_error))

    print("\nFinal Summary")
    print("Total modified:", total_modified)
    print("Total batches:", batch_number)
    print("Total time:", round(time.time() - start_time, 2), "seconds")

    client.close()
